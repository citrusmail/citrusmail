{
  "name": "citrusmail",
  "version": "0.1.1",
  "description": "A simple, themeable mail client for any IMAP, POP3, SMTP, CalDAV and CardDAV server",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "desktop": "nuxt build && electron desktop",
    "desktop:build": "nuxt build && electron-builder --projectDir desktop --config electron-builder.config.cjs --mac",
    "desktop:build:win": "nuxt build && electron-builder --projectDir desktop --config electron-builder.config.cjs --win",
    "desktop:build:linux": "nuxt build && electron-builder --projectDir desktop --config electron-builder.config.cjs --linux",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@iconify-json/lucide": "^1.2.150",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.101",
    "@internationalized/date": "^3.12.4",
    "@nuxt/ui": "^4.12.0",
    "@tiptap/core": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/vue-3": "^3.32.2",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "date-fns": "^4.4.0",
    "gpu-time": "^0.5.0",
    "ical.js": "^2.2.1",
    "imapflow": "^2.10.0",
    "isomorphic-dompurify": "^4.6.0",
    "mailparser": "^3.14.1",
    "nodemailer": "^10.3.1",
    "nuxt": "^4.6.3",
    "nuxt-auth-utils": "^0.6.0",
    "tailwindcss": "^4.3.3",
    "tsdav": "^2.5.0",
    "undici": "^7.30.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/mailparser": "^3.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.16.1"
}
